# ========================================================
# Cloudflare Pages Caching & Security Headers
# Felisberto Despachante - www.felisbertodespachante.com.br
# ========================================================

# Global Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# SPA Entrypoint: Always revalidate so users receive new versions immediately
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Hashed JS/CSS bundles: Immutable cache for 1 year (100% Cache Hit)
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Static Assets, Images, SVGs and Web Fonts: 30 days cache + stale-while-revalidate
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Legal/Form Documents (PDF & Word): 7 days cache
/documentos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# SEO Crawlers (Robots & Sitemap): 1 day cache
/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
